{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'dotkey-ui.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-tabs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0
-%}

<section class="dotkey-tabs color-{{ section.settings.color_scheme }} gradient" id="collection-tabs-{{ section.id }}" data-collection-tabs>
  <div class="page-width section-{{ section.id }}-padding">
    {% if section.settings.title != blank %}
      <div class="title-wrapper title-wrapper--no-top-margin dotkey-tabs__heading">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="dotkey-tabs__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="dotkey-tabs__navigation">
      <button type="button" class="dotkey-tabs__nav-arrow" data-tabs-prev aria-label="Scroll categories left">&#10094;</button>
      <div class="dotkey-tabs__buttons" role="tablist" aria-label="Product collections">
        {% for block in section.blocks %}
          {% assign tab_collection = block.settings.collection %}
          <button
            type="button"
            class="dotkey-tabs__button{% if forloop.first %} is-active{% endif %}"
            id="tab-{{ section.id }}-{{ block.id }}"
            role="tab"
            aria-controls="panel-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-tab-button
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_name | default: tab_collection.title | default: 'Shop collection' | escape }}
          </button>
        {% endfor %}
      </div>
      <button type="button" class="dotkey-tabs__nav-arrow" data-tabs-next aria-label="Scroll categories right">&#10095;</button>
    </div>

    {% if section.blocks.size == 0 %}
      <p class="dotkey-tabs__empty">Add collection tabs in the theme editor to show your products here.</p>
    {% endif %}

    <div class="dotkey-tabs__panels">
      {% for block in section.blocks %}
        {% assign tab_collection = block.settings.collection %}
        {% assign product_count = tab_collection.products_count | default: 0 %}
        {% assign products_to_show = block.settings.products_to_show %}
        {% if product_count > products_to_show %}
          {% assign product_count = products_to_show %}
        {% endif %}
        {% assign show_slider = false %}
        {% if section.settings.enable_desktop_slider and product_count > columns_desktop_int %}
          {% assign show_slider = true %}
        {% endif %}
        {% if section.settings.swipe_on_mobile and product_count > columns_mobile_int %}
          {% assign show_slider = true %}
        {% endif %}

        <div
          class="dotkey-tabs__panel"
          id="panel-{{ section.id }}-{{ block.id }}"
          role="tabpanel"
          aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
          data-tab-panel
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% if tab_collection != blank and tab_collection.products_count > 0 %}
            <slider-component class="slider-mobile-gutter{% if show_slider %} slider-component-desktop{% endif %}">
              <ul
                id="Slider-{{ section.id }}-{{ block.id }}"
                class="grid product-grid contains-card contains-card--product grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if show_slider %} slider{% if section.settings.enable_desktop_slider %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet grid--peek{% endif %}{% endif %}"
                role="list"
                aria-label="{{ tab_collection.title | escape }}"
              >
                {% assign skip_card_product_styles = false %}
                {% for product in tab_collection.products limit: products_to_show %}
                  <li
                    id="Slide-{{ section.id }}-{{ block.id }}-{{ forloop.index }}"
                    class="grid__item{% if show_slider %} slider__slide{% endif %}"
                  >
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      lazy_load: true,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      skip_styles: skip_card_product_styles,
                      section_id: section.id,
                      quick_add: section.settings.quick_add,
                      product_view_context: 'collection'
                    %}
                  </li>
                  {% assign skip_card_product_styles = true %}
                {% endfor %}
              </ul>
              {% if show_slider %}
                <div class="slider-buttons dotkey-tabs__slider-buttons">
                  <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="Previous products" aria-controls="Slider-{{ section.id }}-{{ block.id }}">
                    <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
                  </button>
                  <div class="slider-counter caption">
                    <span class="slider-counter--current">1</span>
                    <span aria-hidden="true"> / </span>
                    <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                    <span class="slider-counter--total">{{ product_count }}</span>
                  </div>
                  <button type="button" class="slider-button slider-button--next" name="next" aria-label="Next products" aria-controls="Slider-{{ section.id }}-{{ block.id }}">
                    <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
                  </button>
                </div>
              {% endif %}
            </slider-component>
            {% if block.settings.show_view_all %}
              <div class="center collection__view-all">
                <a href="{{ tab_collection.url }}" class="button button--primary">{{ block.settings.view_all_label | default: 'Shop all' | escape }}</a>
              </div>
            {% endif %}
          {% else %}
            <p class="dotkey-tabs__empty">Choose a collection for this tab in the theme editor.</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": " collection tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"text","id":"title","label":"Heading","default":"Bestsellers"},
    {"type":"text","id":"subtitle","label":"Subheading","default":"Your favourites, all in one place"},
    {"type":"select","id":"heading_size","label":"Heading size","options":[{"value":"h2","label":"Small"},{"value":"h1","label":"Medium"},{"value":"h0","label":"Large"}],"default":"h1"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},
    {"type":"range","id":"columns_desktop","label":"Products visible on desktop","min":2,"max":5,"step":1,"default":4},
    {"type":"select","id":"columns_mobile","label":"Products visible on mobile","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},
    {"type":"checkbox","id":"enable_desktop_slider","label":"Enable product carousel on desktop","default":true},
    {"type":"checkbox","id":"swipe_on_mobile","label":"Enable swipe on mobile","default":true},
    {"type":"select","id":"image_ratio","label":"Product image ratio","options":[{"value":"adapt","label":"Adapt to image"},{"value":"portrait","label":"Portrait"},{"value":"square","label":"Square"}],"default":"square"},
    {"type":"select","id":"image_shape","label":"Product image shape","options":[{"value":"default","label":"Default"},{"value":"round","label":"Round"},{"value":"arch","label":"Arch"},{"value":"blob","label":"Blob"}],"default":"default"},
    {"type":"checkbox","id":"show_secondary_image","label":"Show second image on hover","default":true},
    {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},
    {"type":"checkbox","id":"show_rating","label":"Show rating","default":false},
    {"type":"select","id":"quick_add","label":"Quick add","options":[{"value":"none","label":"None"},{"value":"standard","label":"Standard"}],"default":"none"},
    {"type":"range","id":"padding_top","label":"Top padding","min":0,"max":100,"step":4,"unit":"px","default":36},
    {"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":100,"step":4,"unit":"px","default":36}
  ],
  "blocks": [
    {
      "type":"collection_tab",
      "name":"Collection tab",
      "settings":[
        {"type":"text","id":"tab_name","label":"Tab label"},
        {"type":"collection","id":"collection","label":"Collection"},
        {"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":16,"step":1,"default":8},
        {"type":"checkbox","id":"show_view_all","label":"Show shop all button","default":true},
        {"type":"text","id":"view_all_label","label":"Button label","default":"Shop all"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {"name":" collection tabs","blocks":[{"type":"collection_tab"}]}
  ]
}
{% endschema %}
