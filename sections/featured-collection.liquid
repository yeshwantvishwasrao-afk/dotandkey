{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{% endif %}

{% unless section.settings.quick_add == 'none' %}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{% endunless %}

{% if section.settings.quick_add == 'standard' %}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% if section.settings.quick_add == 'bulk' %}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collection-tabs-{{ section.id }} .tabs-buttons {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin: 20px 0 35px;
  }

  .collection-tabs-{{ section.id }} .tab-button {
    padding: 14px 28px;
    border: 1px solid transparent;
    border-radius: 16px;
    background: #f0f2f6;
    color: #26354a;
    cursor: pointer;
    font: inherit;
  }

  .collection-tabs-{{ section.id }} .tab-button.active {
    border-color: #ff3e80;
    color: #ff3e80;
  }

  .collection-tabs-{{ section.id }} [hidden] {
    display: none !important;
  }

  .collection-tabs-{{ section.id }} .tab-panel {
    width: 100%;
  }

  .collection-tabs-{{ section.id }} .collection__view-all {
    margin-top: 30px;
  }

  @media screen and (max-width: 749px) {
    .collection-tabs-{{ section.id }} .tabs-buttons {
      gap: 8px;
      margin-bottom: 24px;
    }

    .collection-tabs-{{ section.id }} .tab-button {
      padding: 10px 16px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div
    class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >

    <!-- Bestseller is only the heading -->
    <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width">
      <h2 class="title inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.title | default: 'Bestseller' | escape }}
      </h2>

      {% if section.settings.description != blank %}
        <div class="collection__description {{ section.settings.description_style }} rte">
          {{ section.settings.description }}
        </div>
      {% elsif section.settings.show_description and section.settings.collection != blank and section.settings.collection.description != empty %}
        <div class="collection__description {{ section.settings.description_style }} rte">
          {{ section.settings.collection.description }}
        </div>
      {% endif %}
    </div>

    <!-- Collection tabs -->
    <div class="collection-tabs-{{ section.id }}" data-collection-tabs>

      <!-- Tab buttons -->
      <div class="tabs-buttons page-width" role="tablist" aria-label="Product collections">
        {% for block in section.blocks %}
          {% assign tab_collection = block.settings.tab_collection %}

          <button
            type="button"
            class="tab-button{% if forloop.first %} active{% endif %}"
            id="tab-{{ section.id }}-{{ block.id }}"
            role="tab"
            aria-controls="panel-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab-button
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_name | default: tab_collection.title | default: 'Collection' | escape }}
          </button>
        {% endfor %}
      </div>

      <!-- Each tab displays its selected collection -->
      {% for block in section.blocks %}
        {% assign tab_collection = block.settings.tab_collection %}

        <div
          id="panel-{{ section.id }}-{{ block.id }}"
          class="tab-panel"
          role="tabpanel"
          aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
          data-tab-panel
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >

          {% if tab_collection != blank %}

            {% assign tab_product_count = tab_collection.products_count %}

            <slider-component
              class="slider-mobile-gutter{% if section.settings.full_width %} slider-component-full-width{% endif %}{% if section.settings.swipe_on_mobile == false and section.settings.enable_desktop_slider == false %} page-width{% endif %}"
            >
              <ul
                id="Slider-{{ section.id }}-{{ block.id }}"
                class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if section.settings.enable_desktop_slider %} slider slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider slider--tablet{% endif %}"
                role="list"
              >
                {% for product in tab_collection.products limit: section.settings.products_to_show %}
                  <li
                    id="Slide-{{ section.id }}-{{ block.id }}-{{ forloop.index }}"
                    class="grid__item{% if section.settings.enable_desktop_slider %} slider__slide{% endif %}{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}"
                  >
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      lazy_load: true,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      section_id: section.id,
                      quick_add: section.settings.quick_add
                    %}
                  </li>
                {% else %}
                  <li class="grid__item">
                    <p>This collection has no products to display.</p>
                  </li>
                {% endfor %}
              </ul>

              {% if section.settings.enable_desktop_slider or section.settings.swipe_on_mobile %}
                <div class="slider-buttons no-js-hidden">
                  <button
                    type="button"
                    class="slider-button slider-button--prev"
                    name="previous"
                    aria-label="{{ 'general.slider.previous_slide' | t }}"
                    aria-controls="Slider-{{ section.id }}-{{ block.id }}"
                  >
                    <span class="svg-wrapper">
                      {{ 'icon-caret.svg' | inline_asset_content }}
                    </span>
                  </button>

                  <div class="slider-counter caption">
                    <span class="slider-counter--current">1</span>
                    <span aria-hidden="true"> / </span>
                    <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                    <span class="slider-counter--total">
                      {{ tab_product_count | at_most: section.settings.products_to_show }}
                    </span>
                  </div>

                  <button
                    type="button"
                    class="slider-button slider-button--next"
                    name="next"
                    aria-label="{{ 'general.slider.next_slide' | t }}"
                    aria-controls="Slider-{{ section.id }}-{{ block.id }}"
                  >
                    <span class="svg-wrapper">
                      {{ 'icon-caret.svg' | inline_asset_content }}
                    </span>
                  </button>
                </div>
              {% endif %}
            </slider-component>

            <!-- View all links to this tab's collection -->
            {% if section.settings.show_view_all and tab_product_count > section.settings.products_to_show %}
              <div class="center collection__view-all">
                <a
                  href="{{ tab_collection.url }}"
                  class="{% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
                  aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: tab_collection.title | escape }}"
                >
                  {{ 'sections.featured_collection.view_all' | t }}
                </a>
              </div>
            {% endif %}

          {% else %}
            <div class="page-width">
              <p>Select a collection for this tab in the theme editor.</p>
            </div>
          {% endif %}

        </div>
      {% endfor %}

      {% if section.blocks.size == 0 %}
        <div class="page-width">
          <p>Add a Collection tab block and select a collection.</p>
        </div>
      {% endif %}

    </div>

    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {% endif %}

  </div>
</div>

<script>
  (function () {
    function initializeCollectionTabs(container) {
      if (!container || container.dataset.tabsInitialized === 'true') return;

      container.dataset.tabsInitialized = 'true';

      const buttons = container.querySelectorAll('[data-tab-button]');
      const panels = container.querySelectorAll('[data-tab-panel]');

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          buttons.forEach(function (tab) {
            tab.classList.remove('active');
            tab.setAttribute('aria-selected', 'false');
          });

          panels.forEach(function (panel) {
            panel.hidden = true;
          });

          button.classList.add('active');
          button.setAttribute('aria-selected', 'true');

          const panelId = button.getAttribute('aria-controls');
          const activePanel = container.querySelector('#' + panelId);

          if (activePanel) {
            activePanel.hidden = false;
          }
        });
      });
    }

    document.querySelectorAll('[data-collection-tabs]').forEach(function (container) {
      initializeCollectionTabs(container);
    });

    document.addEventListener('shopify:section:load', function (event) {
      const containers = event.target.querySelectorAll('[data-collection-tabs]');

      containers.forEach(function (container) {
        initializeCollectionTabs(container);
      });
    });
  })();
</script>

{% schema %}
{
