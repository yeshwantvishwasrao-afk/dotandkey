
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'dev.css' | asset_url | stylesheet_tag }}

{% assign has_blob = false %}
{% assign has_quick_add = false %}
{% assign has_standard_quick_add = false %}

{% for block in section.blocks %}
  {% if block.settings.image_shape == 'blob' %}
    {% assign has_blob = true %}
  {% endif %}

  {% if block.settings.quick_add != 'none' %}
    {% assign has_quick_add = true %}
  {% endif %}

  {% if block.settings.quick_add == 'standard' %}
    {% assign has_standard_quick_add = true %}
  {% endif %}
{% endfor %}

{% if has_blob %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{% endif %}

{% if has_quick_add %}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% if has_standard_quick_add %}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{% endif %}

<div
  class="color-{{ section.settings.color_scheme }} isolate gradient"
  id="collection-{{ section.id }}"
>
  <div class="collection section-{{ section.id }}-padding">

    <!-- BESTSELLER HEADING -->
    <div class="dev-heading page-width">
      <h2
        class="title inline-richtext {{ section.settings.heading_size }}"
        style="
          text-align: {{ section.settings.heading_alignment }};
          width: {{ section.settings.heading_width }}%;
        "
      >
        {{ section.settings.title | default: 'Bestseller' | escape }}
      </h2>
    </div>

    <!-- COLLECTION TABS -->
    <div class="dev-tabs" data-collection-tabs>

      <div class="dev-tabs__buttons page-width" role="tablist">
        {% for block in section.blocks %}
          {% assign tab_collection = block.settings.tab_collection %}

          <button
            type="button"
            class="dev-tabs__button{% if forloop.first %} active{% endif %}"
            id="tab-{{ section.id }}-{{ block.id }}"
            role="tab"
            aria-controls="panel-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab-button
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_name | default: tab_collection.title | default: 'Collection' | escape }}
          </button>
        {% endfor %}
      </div>

      <!-- PRODUCTS FOR EACH COLLECTION TAB -->
      {% for block in section.blocks %}
        {% assign tab_collection = block.settings.tab_collection %}

        <div
          id="panel-{{ section.id }}-{{ block.id }}"
          class="dev-tabs__panel"
          role="tabpanel"
          aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
          data-tab-panel
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% if tab_collection != blank %}

            <ul
              class="
                grid product-grid
                grid--{{ block.settings.columns_desktop }}-col-desktop
                grid--{{ block.settings.columns_mobile }}-col-tablet-down
                {% if block.settings.enable_desktop_slider %}dev-product-slider{% endif %}
                {% if block.settings.swipe_on_mobile %}dev-product-slider-mobile{% endif %}
              "
              role="list"
            >
              {% for product in tab_collection.products limit: block.settings.products_to_show %}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: block.settings.image_ratio,
                    image_shape: block.settings.image_shape,
                    lazy_load: true,
                    show_secondary_image: block.settings.show_secondary_image,
                    show_vendor: block.settings.show_vendor,
                    show_rating: block.settings.show_rating,
                    section_id: section.id,
                    quick_add: block.settings.quick_add
                  %}
                </li>
              {% else %}
                <li class="grid__item">
                  <p>No products found in this collection.</p>
                </li>
              {% endfor %}
            </ul>

            {% if block.settings.show_view_all and tab_collection.products_count > block.settings.products_to_show %}
              <div class="center dev-view-all">
                <a
                  href="{{ tab_collection.url }}"
                  class="
                    {% if block.settings.view_all_style == 'link' %}
                      link underlined-link
                    {% elsif block.settings.view_all_style == 'solid' %}
                      button
                    {% else %}
                      button button--secondary
                    {% endif %}
                  "
                >
                  View all
                </a>
              </div>
            {% endif %}

          {% else %}
            <div class="page-width">
              <p>Select a collection for this tab in the theme editor.</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}

      {% if section.blocks.size == 0 %}
        <div class="page-width">
          <p>Add a Collection tab block and select a collection.</p>
        </div>
      {% endif %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading text",
      "default": "Bestseller"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" },
        { "value": "hxxl", "label": "Extra extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_width",
      "label": "Heading width",
      "min": 25,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab name",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "collection",
          "id": "tab_collection",
          "label": "Choose collection"
        },
        {
          "type": "header",
          "content": "Product display"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 2,
          "max": 25,
          "step": 1,
          "default": 4
        },
        {
          "type": "range",
          "id": "columns_desktop",
          "label": "Desktop columns",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 4
        },
        {
          "type": "select",
          "id": "columns_mobile",
          "label": "Mobile columns",
          "options": [
            { "value": "1", "label": "1 column" },
            { "value": "2", "label": "2 columns" }
          ],
          "default": "2"
        },
        {
          "type": "checkbox",
          "id": "enable_desktop_slider",
          "label": "Carousel on desktop",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "swipe_on_mobile",
          "label": "Swipe on mobile",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_view_all",
          "label": "Show View all button",
          "default": true
        },
        {
          "type": "select",
          "id": "view_all_style",
          "label": "View all button style",
          "options": [
            { "value": "link", "label": "Link" },
            { "value": "outline", "label": "Outline" },
            { "value": "solid", "label": "Solid" }
          ],
          "default": "solid"
        },
        {
          "type": "header",
          "content": "Product cards"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Product image ratio",
          "options": [
            { "value": "adapt", "label": "Adapt to image" },
            { "value": "portrait", "label": "Portrait" },
            { "value": "square", "label": "Square" }
          ],
          "default": "adapt"
        },
        {
          "type": "select",
          "id": "image_shape",
          "label": "Product image shape",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "arch", "label": "Arch" },
            { "value": "blob", "label": "Blob" },
            { "value": "chevronleft", "label": "Chevron left" },
            { "value": "chevronright", "label": "Chevron right" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "parallelogram", "label": "Parallelogram" },
            { "value": "round", "label": "Round" }
          ],
          "default": "default"
        },
        {
          "type": "checkbox",
          "id": "show_secondary_image",
          "label": "Show second image on hover",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show product rating",
          "default": false
        },
        {
          "type": "select",
          "id": "quick_add",
          "label": "Quick add",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "standard", "label": "Standard" },
            { "value": "bulk", "label": "Bulk" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Featured collection tabs",
      "blocks": [
        { "type": "collection_tab" },
        { "type": "collection_tab" }
      ]
    }
  ]
}
{% endschema %}
