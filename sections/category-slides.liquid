{{ 'dev-category-tiles.css' | asset_url | stylesheet_tag }}

<section class="dev-ys-category-tiles" id="dev-ys-tiles-{{ section.id }}">
  <div class="dev-ys-category-tiles__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_url = '#'
        if block.settings.collection != blank
          assign tile_url = block.settings.collection.url
        elsif block.settings.link != blank
          assign tile_url = block.settings.link
        endif
        assign tile_title = block.settings.title
        if tile_title == blank and block.settings.collection != blank
          assign tile_title = block.settings.collection.title
        endif
      -%}
      <div class="dev-ys-category-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag:
            class: 'dev-ys-category-tile__img',
            widths: '400, 600, 900',
            sizes: '(min-width: 990px) 23vw, 70vw',
            loading: 'lazy'
          }}
        {%- else -%}
          <div class="dev-ys-category-tile__img dev-ys-category-tile__placeholder"></div>
        {%- endif -%}

        {%- comment -%} Title and arrow both link to the collection {%- endcomment -%}
        <a class="dev-ys-category-tile__title" href="{{ tile_url }}">{{ tile_title }}</a>
        <a class="dev-ys-category-tile__arrow" href="{{ tile_url }}" aria-label="{{ tile_title | escape }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Title (leave empty to use collection name)" },
        { "type": "collection", "id": "collection", "label": "Collection to open" },
        { "type": "url", "id": "link", "label": "Or custom link (used if no collection)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
